{
  "name": "kiddie-chess-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Standalone TypeScript PWA — single-player Adventure mode for Kiddie Chess",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "CAPACITOR=1 BASE_PATH=/ vite --host",
    "build": "tsc && vite build",
    "build:mobile": "CAPACITOR=1 BASE_PATH=/ npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/generate-icons.mjs",
    "android:build": "bash scripts/mobile/build-android.sh",
    "android:release": "bash scripts/mobile/build-android.sh --release --bundle",
    "android:open": "bash scripts/mobile/build-android.sh --open",
    "android:run": "bash scripts/mobile/build-android.sh --run",
    "ios:build": "bash scripts/mobile/build-ios.sh",
    "ios:release": "bash scripts/mobile/build-ios.sh --ipa",
    "ios:open": "bash scripts/mobile/build-ios.sh --open",
    "ios:run": "bash scripts/mobile/build-ios.sh --run",
    "cap": "cap",
    "cap:sync": "npm run build:mobile && cap sync",
    "cap:doctor": "cap doctor",
    "mobile:assets": "node scripts/generate-mobile-assets.mjs",
    "mobile:clean": "rm -rf dist dist-mobile android/app/build ios/build ios/App/build"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "sharp": "^0.35.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
